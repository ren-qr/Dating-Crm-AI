# 复制为 .env 并填写实际值

# PostgreSQL 连接串；docker-compose.yml 默认提供同名本地演示库
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/date_manage?schema=public"

# 演示 seed 使用的门店 ID 与统一演示密码；可按本地需要覆盖
DEMO_STORE_ID="demo-store-shanghai"
DEMO_SEED_PASSWORD="Demo@123456"

# 站点基准地址，用于 NextAuth Credentials 回调与会话校验
NEXTAUTH_URL="http://localhost:3000"

# NextAuth 会话签名密钥
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"

# Bootstrap 阶段临时管理员，仅用于无数据库或未 seed 时的 Credentials 骨架联调
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me"

# 会员敏感资料字段加密密钥，用于资料加密存储
APP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# 资料文件存储提供方标识，本地或对象存储
FILE_STORAGE_PROVIDER="local"

# 证件资料文件桶或目录名
FILE_STORAGE_BUCKET="member-documents"

# 对象存储区域，若使用云存储
FILE_STORAGE_REGION=

# 对象存储访问密钥，若使用云存储
FILE_STORAGE_ACCESS_KEY=

# 对象存储私钥，若使用云存储
FILE_STORAGE_SECRET_KEY=

# 导出与备份文件保存路径
EXPORT_STORAGE_PATH="./storage/exports"

# 回访提醒与定时任务使用的时区
CRON_TZ="Asia/Shanghai"

# 到期回访提醒任务调度表达式
REMINDER_JOB_CRON="0 9 * * *"

# AI 助理模型提供方：mock / ollama / deepseek
AI_PROVIDER="ollama"
AI_TIMEOUT_MS="30000"
AI_TEMPERATURE="0.2"

# 本地 Ollama 配置
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.6:35b"

# DeepSeek 云端模型配置；密钥只保存在服务端 .env，不会返回前端
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL="deepseek-v4-flash"
